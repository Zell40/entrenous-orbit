# Orbit always POSTs image/voice uploads to the literal same-origin path
# `/upload` or `/app/upload` (see src/core/store/upload.ts) — it has no idea
# the actual PHP script is called filehost-upload.php.
#
# This .htaccess lives in WEBROOT, which EntreNous serves via Alias /app →
# WEBROOT. Per-directory rewrite sees the path *after* the Alias prefix, so
# a browser request to /app/upload matches ^upload$ here.
#
# Targets MUST be relative (no leading slash). A leading slash is resolved
# against the vhost DocumentRoot, which is NOT WEBROOT when using Alias —
# that was a common cause of 404 despite filehost-upload.php being present.
#
# See server/filehost/README.md for the full setup (ircd module + secrets).
RewriteEngine On
RewriteRule ^upload$ filehost-upload.php [L,QSA]
# Orbit batches avatar lookups to this path (src/platform/avatars.ts).
RewriteRule ^accounts/api/avatars/?$ avatars.php [L,QSA]
# Session resume: mint a fresh SASL OAUTHBEARER JWT from the handoff cookie.
RewriteRule ^accounts/api/chat_resume/?$ chat-resume.php [L,QSA]
# WP profile → IRC GECOS (âge - genre - ville) for reconnect SETNAME.
RewriteRule ^accounts/api/profile_gecos/?$ profile-gecos.php [L,QSA]
# OpenGraph cards for chat / Actu link previews (Orbit src/lib/link-preview.tsx).
RewriteRule ^accounts/api/unfurl/?$ unfurl.php [L,QSA]

# Raise upload limits for composer /upload when under mod_php (FPM uses .user.ini).
<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 16M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 16M
</IfModule>
