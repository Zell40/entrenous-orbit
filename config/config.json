{
  "server": {
    "url": "https://irc.entrenous.chat/",
    "guestIdent": "ENuser",
    "guestIdentFromNick": true,
    "bouncerUrl": "wss://bnc.reseau-entrenous.fr/webirc/websocket/",
    "bouncerHost": "bnc.entrenous.chat:+8066"
  },
  "startup": {
    "channels": [
      "#EntreNous.chat"
    ],
    "suggestions": [
      "#Aide.chat",
      "#Baccalaureat.chat",
      "#Motus.chat",
      "#Uno.chat",
      "#Echecs.chat",
      "#HarryPotter.chat",
      "#CCAS.chat",
      "#EDFGDF.chat",
      "#Enedis.chat"
    ],
    "intents": {
      "chat": ["#EntreNous.chat"],
      "love": ["#EDFGDF.chat"],
      "play": ["#Baccalaureat.chat", "#Echecs.chat", "#HarryPotter.chat"]
    }
  },
  "branding": {
    "name": "EntreNous",
    "icon": "https://www.reseau-entrenous.fr/wp-content/uploads/2021/11/cropped-icone_ren.png",
    "url": "https://www.entrenous.chat",
    "tagline": "Tchat des Electricien(ne)s et Gazier(e)s Français(es),",
    "taglineEm": "nous vous accueillons maintenant!",
    "subtitle": "Tchat français en direct. Choisissez un pseudo, et vous y êtes.",
    "projectUrl": "https://www.reseau-entrenous.fr/articles/NouveauWebchat",
    "registerUrl": "https://www.reseau-entrenous.fr/register/",
    "loginUrl": "https://www.reseau-entrenous.fr/login/",
    "links": [],
    "accent": ""
  },
  "turnstile": {
    "enabled": true,
    "sitekey": "0x4AAAAAADlXGeFQ-Aj3Kitp"
  },
  "report": {
    "service": "",
    "target": "#_bo",
    "query": "SignalMoi"
  },
  "defaults": {
    "theme": "light",
    "compact": true,
    "sound": true,
    "hideJoinQuit": true,
    "clock24": true,
    "lang": ""
  },
  "features": {
    "push": true,
    "pushRequireAccount": true,
    "imageUpload": true,
    "register": true,
    "linkPreviews": true,
    "multiNetwork": false,
    "sessionResume": true,
    "passkeySasl": true,
    "saslScram": true,
    "saslOauthBearer": true,
    "bouncer": true
  },
  "filehost": {
    "retentionHours": 24,
    "retentionChoices": [1, 6, 24, 72]
  },
  "roomGallery": {
    "writers": ["Founder", "Admin"]
  },
  "conference": {
    "server": "visio.entrenous.chat",
    "secure": true,
    "tokenEndpoint": "/app/plugins/third/orbit-conference/visio-jwt.php",
    "tagID": "1",
    "channels": true,
    "queries": true,
    "enabledInChannels": ["*"],
    "disabledInChannels": [],
    "viewHeight": "46%",
    "viewHeightMobile": "28%",
    "requireAccount": true,
    "requireChannelOp": true,
    "startPrefixes": "~&@",
    "denyGroups": ["controle-parentale"],
    "requireGroups": [],
    "maxParticipantsChannel": 20,
    "maxParticipantsQuery": 2,
    "anyoneCanStartIn": ["#Visio.chat"],
    "channelRules": {
      "#Visio.chat": {
        "requireChannelOp": false
      }
    },
    "publicLinkInInvite": true,
    "hideInviteForOrbit": true,
    "inviteText": "-{{ nick }}- vous invite à rejoindre la conférence. Cliquez sur le lien pour y acceder : {{ link }}",
    "joinText": "-{{ nick }}- vous invite à rejoindre la conférence. Cliquez sur le lien pour y acceder : {{ link }}",
    "joinButtonText": "Rejoindre"
  },
  "petitbac": {
    "channels": ["#Baccalaureat.chat"],
    "showWhenIdle": true,
    "defaultCollapsed": true,
    "maxPlayers": 14
  },
  "echecs": {
    "channels": ["#Echecs.chat"],
    "showWhenIdle": true,
    "botNicks": ["CapEchecs", "JeuEchecs"]
  },
  "harrypotter": {
    "channels": ["#HarryPotter.chat"],
    "showWhenIdle": true,
    "defaultCollapsed": true,
    "botNicks": ["Choixpeau"]
  },
  "asl": {
    "requireAge": true,
    "requireGender": true,
    "requireCity": true,
    "minAge": 10
  },
  "callerid": {
    "group": "controle-parentale",
    "modes": "+ixIgcRw",
    "autoMode": true
  },
  "helpservWelcome": {
    "bots": [
      {
        "nick": "EcoutE",
        "needle": "idée ou un avis",
        "lines": [
          "Bonjour {{nick}}, merci de partager une idée ou un avis.",
          "Décrivez votre suggestion en quelques mots (amélioration, nouveau salon, fonctionnalité…). Un ticket sera ouvert dès que votre message sera suffisamment clair.",
          "Vous pouvez également ajouter des photos si vous le souhaitez."
        ]
      }
    ]
  },
  "helpdesk": {
    "label": "Aide",
    "title": "Aide, signalement, idées",
    "desks": [
      {
        "id": "aide",
        "label": "Aide",
        "title": "Demander de l’aide",
        "bot": "AideMoi",
        "channel": "#Aide.chat",
        "links": [
          { "label": "Aide sur le site", "url": "https://www.reseau-entrenous.fr/aide/" }
        ]
      },
      {
        "id": "signal",
        "label": "Signaler",
        "title": "Signaler un problème",
        "bot": "SignalMoi",
        "channel": "#Signalement.chat",
        "links": [
          { "label": "Aide signalement", "url": "https://www.reseau-entrenous.fr/salons/salon-signalement/" }
        ]
      },
      {
        "id": "idees",
        "label": "Idées",
        "title": "Idées et suggestions",
        "bot": "EcoutE",
        "channel": "#Idees.chat",
        "links": [
          { "label": "Le réseau EntreNous", "url": "https://www.reseau-entrenous.fr/" }
        ]
      }
    ]
  },
  "plugins": [
    { "url": "/app/plugins/third/orbit-clock.js", "sandbox": true, "permissions": ["none"] },
    { "url": "/app/plugins/third/orbit-radio.js?v=5", "sandbox": true, "permissions": ["storage", "irc"] },
    "/app/plugins/third/orbit-helpdesk/orbit-helpdesk.js?v=4",
    "/app/plugins/third/orbit-copy.js",
    "/app/plugins/third/orbit-invite.js",
    "/app/plugins/third/orbit-navbar.js",
    "/app/plugins/third/orbit-room-gallery/orbit-room-gallery.js?v=32",
    "/app/plugins/third/orbit-helpserv-welcome/orbit-helpserv-welcome.js?v=7",
    "/app/plugins/third/orbit-anope/orbit-anope.js?v=10",
    "/app/plugins/third/orbit-chanserv/orbit-chanserv.js?v=14",
    "/app/plugins/third/orbit-conference/orbit-conference.js?v=17",
    "/app/plugins/third/orbit-petitbac/orbit-petitbac.js?v=77",
    "/app/plugins/third/orbit-echecs/orbit-echecs.js?v=53",
    "/app/plugins/third/orbit-harrypotter/orbit-harrypotter.js?v=3",
    "/app/plugins/third/orbit-callerid/orbit-callerid.js?v=18",
    "/app/plugins/third/orbit-asl/orbit-asl.js?v=2"
  ],
  "builtins": [],
