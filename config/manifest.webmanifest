{
  "name": "EntreNous — Tchat",
  "short_name": "EntreNous",
  "id": "/app/",
  "description": "Tchat des Electricien(ne)s et Gazier(e)s Français(es). Salons publics, messages privés, sans installation Play Store.",
  "lang": "fr",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0d1b3e",
  "theme_color": "#1452cc",
  "prefer_related_applications": false,
  "related_applications": [],
  "categories": ["social", "communication"],
  "icons": [
    { "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/app/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ]
}
